# Production only
# - NODE_ENV=production (disables in-memory DB fallback; enforces secure cookies)
# - MONGODB_URI points to MongoDB Atlas
# - CLIENT_ORIGIN accepts a comma-separated list of allowed origins
# - JWT_SECRET is required; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - Cloudinary image uploads (optional; falls back to local disk when absent)
